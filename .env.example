# Copy to .env; generate local secrets as documented. Never commit .env.
APP_KEY=
BACKEND_PORT=8000
POSTGRES_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
SESSION_SECURE_COOKIE=false
# Optional pgAdmin profile. Set the password only in ignored root .env.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
